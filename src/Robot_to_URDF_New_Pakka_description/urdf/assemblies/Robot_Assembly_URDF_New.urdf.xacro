<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Robot_Assembly_URDF_New_macro">

  <xacro:macro name="Robot_Assembly_URDF_New" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.000000 0.000148 0.020775" rpy="0 0 0"/>
        <mass value="10.528007"/>
        <inertia ixx="3.546454e-02" ixy="-3.583128e-11" ixz="-4.191711e-11"
                 iyy="3.556442e-02" iyz="1.226315e-04" izz="2.879027e-02"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Wrist_Motor">
      <inertial>
        <origin xyz="0.010896 -0.000044 0.108189" rpy="0 0 0"/>
        <mass value="2.109552"/>
        <inertia ixx="4.701895e-03" ixy="-2.639002e-06" ixz="-5.009290e-04"
                 iyy="5.708233e-03" iyz="2.609188e-06" izz="2.625985e-03"/>
      </inertial>
      <visual>
        <origin xyz="-0.015700 0.000000 0.130000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/Wrist_Motor.dae" scale="1 1 1"/>
        </geometry>
        <material name="Stainless_Steel_304"/>
      </visual>
      <collision>
        <origin xyz="-0.015700 0.000000 0.130000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/Wrist_Motor_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}L110I_Shoulder">
      <inertial>
        <origin xyz="0.000000 -0.109833 0.011323" rpy="0 0 0"/>
        <mass value="6.625323"/>
        <inertia ixx="1.448067e-02" ixy="-1.914920e-08" ixz="-1.120154e-08"
                 iyy="9.292438e-03" iyz="6.850439e-04" izz="1.576078e-02"/>
      </inertial>
      <visual>
        <origin xyz="-0.000000 -0.119000 -0.023000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/L110I_Shoulder.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.000000 -0.119000 -0.023000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/L110I_Shoulder_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}L110I_shoulder_2">
      <inertial>
        <origin xyz="-0.000000 0.332413 -0.045103" rpy="0 0 0"/>
        <mass value="9.267654"/>
        <inertia ixx="2.063923e-01" ixy="1.193072e-08" ixz="1.229002e-08"
                 iyy="1.345004e-02" iyz="-4.638621e-03" izz="2.074487e-01"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.426000 -0.076972" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/L110I_shoulder_2.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.426000 -0.076972" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Robot_to_URDF_New_Pakka_description/meshes/Robot_Assembly_URDF_New/L110I_shoulder_2_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}Revolute_1" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}L110I_Shoulder"/>
      <origin xyz="0.000000 0.000000 0.080000" rpy="-1.570796 0.000000 -0.000000"/>
      <axis xyz="0.000000 1.000000 -0.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_2" type="continuous">
      <parent link="${prefix}L110I_Shoulder"/>
      <child link="${prefix}L110I_shoulder_2"/>
      <origin xyz="-0.000000 -0.119000 0.057000" rpy="3.141593 0.000000 -0.000000"/>
      <axis xyz="0.000000 -0.000000 1.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}Robot_Assembly_URDF_New_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/Robot_Assembly_URDF_New_system/cmd</param>
        <param name="state_topic">sim/Robot_Assembly_URDF_New_system/state</param>
      </hardware>

      <joint name="${prefix}Revolute_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>