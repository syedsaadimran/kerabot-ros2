<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="sticker_workcell">
    <!-- Directional Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Standard Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Physics configuration -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Industrial Workstation Table Base (Z top at 0.0m) -->
    <model name="industrial_workstation_table">
      <static>true</static>
      <link name="table_link">
        <pose>0.0 0.0 -0.05 0 0 0</pose>
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.6 1.6 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.6 1.6 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1.0</ambient>
            <diffuse>0.4 0.4 0.45 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sticker Pick Substrate Plate (Pick Location: X=0.25, Y=-0.30, Z_top=0.22) -->
    <model name="sticker_pick_substrate">
      <static>true</static>
      <link name="substrate_link">
        <pose>0.25 -0.30 0.11 0 0 0</pose>
        <collision name="substrate_collision">
          <geometry>
            <box>
              <size>0.40 0.35 0.22</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="substrate_visual">
          <geometry>
            <box>
              <size>0.40 0.35 0.22</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.15 1.0</ambient>
            <diffuse>0.90 0.70 0.20 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Placement Surface / Target Tray (Place Location: X=-0.25, Y=-0.30, Z_top=0.22) -->
    <model name="sticker_placement_target">
      <static>true</static>
      <link name="placement_link">
        <pose>-0.25 -0.30 0.11 0 0 0</pose>
        <collision name="placement_collision">
          <geometry>
            <box>
              <size>0.40 0.35 0.22</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="placement_visual">
          <geometry>
            <box>
              <size>0.40 0.35 0.22</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.50 0.75 1.0</ambient>
            <diffuse>0.20 0.60 0.85 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- GUI Camera Perspective -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.2 -1.5 1.0 0 0.5 2.1</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
