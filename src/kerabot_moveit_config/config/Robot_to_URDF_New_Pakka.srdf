<?xml version="1.0" encoding="UTF-8"?>
<robot name="Robot_to_URDF_New_Pakka">
    <!--GROUPS-->
    <group name="arm">
        <chain base_link="base_link" tip_link="end_effector_box_link"/>
    </group>

    <!--GROUP STATES-->
    <group_state name="home" group="arm">
        <joint name="Revolute_1" value="0"/>
        <joint name="Revolute_2" value="-0.5"/>
        <joint name="Revolute_3" value="1.0"/>
        <joint name="Revolute_4" value="0"/>
        <joint name="Revolute_5" value="-0.5"/>
        <joint name="ee_rotation_joint" value="0"/>
    </group_state>

    <!--VIRTUAL JOINT-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <!--DISABLE COLLISIONS FOR ADJACENT AND NEVER-TOUCHING STRUCTURAL LINKS-->
    <!-- Base link -->
    <disable_collisions link1="base_link" link2="L110I_Shoulder" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="L110I_shoulder_2" reason="Never"/>
    <disable_collisions link1="base_link" link2="J2J3_Shoulder" reason="Never"/>
    <disable_collisions link1="base_link" link2="Wrist_Motor" reason="Never"/>
    <disable_collisions link1="base_link" link2="L70IE_Finger" reason="Never"/>

    <!-- Link 1 (L110I_Shoulder) -->
    <disable_collisions link1="L110I_Shoulder" link2="L110I_shoulder_2" reason="Adjacent"/>
    <disable_collisions link1="L110I_Shoulder" link2="J2J3_Shoulder" reason="Never"/>
    <disable_collisions link1="L110I_Shoulder" link2="Wrist_Motor" reason="Never"/>
    <disable_collisions link1="L110I_Shoulder" link2="L70IE_Finger" reason="Never"/>

    <!-- Link 2 (L110I_shoulder_2) -->
    <disable_collisions link1="L110I_shoulder_2" link2="J2J3_Shoulder" reason="Adjacent"/>
    <disable_collisions link1="L110I_shoulder_2" link2="Wrist_Motor" reason="Never"/>
    <disable_collisions link1="L110I_shoulder_2" link2="L70IE_Finger" reason="Never"/>

    <!-- Link 3 (J2J3_Shoulder) -->
    <disable_collisions link1="J2J3_Shoulder" link2="Wrist_Motor" reason="Adjacent"/>
    <disable_collisions link1="J2J3_Shoulder" link2="L70IE_Finger" reason="Never"/>

    <!-- Link 4/5 (Wrist_Motor & L70IE_Finger) -->
    <disable_collisions link1="Wrist_Motor" link2="L70IE_Finger" reason="Adjacent"/>

    <!-- End Effector Box: Exclude immediate forearm/wrist links.
         ALL other links (L110I_shoulder_2, L110I_Shoulder, base_link) and ground
         are strictly collision-checked. -->
    <disable_collisions link1="end_effector_box_link" link2="L70IE_Finger" reason="Adjacent"/>
    <disable_collisions link1="end_effector_box_link" link2="Wrist_Motor" reason="Adjacent"/>
    <disable_collisions link1="end_effector_box_link" link2="J2J3_Shoulder" reason="Never"/>
</robot>
